# QuickJS-NG is embedded without quickjs-libc, module loaders or OS bindings.
set(HLS_QUICKJS_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.deps/quickjs-0.18.0")
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/third_party/quickjs-ng-0.18.0.tar.gz" HLS_QJS_HASH)
if(NOT HLS_QJS_HASH STREQUAL "28bcd89aa3683fd2a946537e5ce3f11cc46b5cbf3383c7561aaef3df5ff9f1dd")
  message(FATAL_ERROR "QuickJS-NG source checksum mismatch")
endif()
if(NOT EXISTS "${HLS_QUICKJS_ROOT}/quickjs.c")
  file(ARCHIVE_EXTRACT INPUT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/quickjs-ng-0.18.0.tar.gz" DESTINATION "${CMAKE_CURRENT_SOURCE_DIR}/.deps")
endif()
# Host-owned Wasm memory must not be transferred out of our tracked ArrayBuffer.
# QuickJS-NG 0.18 permits same-length transfer even without a realloc callback;
# reject that case in a generated copy to keep grow/close detachment complete.
file(READ "${HLS_QUICKJS_ROOT}/quickjs.c" HLS_QJS_SOURCE)
set(HLS_QJS_TRANSFER_CHECK "    if (abuf->detached)\n        return JS_ThrowTypeErrorDetachedArrayBuffer(ctx);\n    pmax_len = NULL;")
string(FIND "${HLS_QJS_SOURCE}" "${HLS_QJS_TRANSFER_CHECK}" HLS_QJS_CHECKPOINT)
if(HLS_QJS_CHECKPOINT LESS 0)
  message(FATAL_ERROR "QuickJS host buffer adaptation no longer matches pinned source")
endif()
string(REPLACE "${HLS_QJS_TRANSFER_CHECK}" "    if (abuf->detached)\n        return JS_ThrowTypeErrorDetachedArrayBuffer(ctx);\n    if (!abuf->realloc_func)\n        return JS_ThrowTypeError(ctx, \"host-owned ArrayBuffer is not transferable\");\n    pmax_len = NULL;" HLS_QJS_SOURCE "${HLS_QJS_SOURCE}")
set(HLS_QJS_PATCHED "${CMAKE_CURRENT_BINARY_DIR}/generated/quickjs_hls.c")
file(WRITE "${HLS_QJS_PATCHED}" "/* HLS host-owned buffer adaptation; upstream source follows. */\n${HLS_QJS_SOURCE}")
add_library(hls_quickjs STATIC "${HLS_QJS_PATCHED}" "${HLS_QUICKJS_ROOT}/dtoa.c" "${HLS_QUICKJS_ROOT}/libregexp.c" "${HLS_QUICKJS_ROOT}/libunicode.c")
set_property(TARGET hls_quickjs PROPERTY C_STANDARD 11)
target_include_directories(hls_quickjs SYSTEM PUBLIC "${HLS_QUICKJS_ROOT}")
target_compile_definitions(hls_quickjs PRIVATE _GNU_SOURCE)
target_link_libraries(hls_quickjs PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
if(WIN32)
  target_compile_definitions(hls_quickjs PRIVATE _WIN32_WINNT=0x0601 WINVER=0x0601 WIN32_LEAN_AND_MEAN NOMINMAX)
else()
  target_link_libraries(hls_quickjs PUBLIC m)
endif()
if(MSVC)
  target_compile_options(hls_quickjs PRIVATE /experimental:c11atomics /utf-8)
endif()
if(MSVC AND HLS_STATIC_RUNTIME)
  set_property(TARGET hls_quickjs PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
endif()

# GCC 32-bit targets such as RV32 need the compiler atomic runtime.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SIZEOF_VOID_P EQUAL 4 AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
  target_link_libraries(hls_quickjs PUBLIC atomic)
endif()
