# Prepacked assets keep an offline build possible without Python or npm.
find_package(Python3 COMPONENTS Interpreter QUIET)
if(Python3_Interpreter_FOUND)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/assets/pack_web.py" RESULT_VARIABLE HLS_PACK_RESULT)
  if(NOT HLS_PACK_RESULT EQUAL 0)
    message(FATAL_ERROR "Web resource packing failed")
  endif()
endif()
set(HLS_WEB_BUNDLE "${CMAKE_CURRENT_SOURCE_DIR}/resources/web.gz")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_SOURCE_DIR}/tools/assets/pack_web.py"
  "${CMAKE_CURRENT_SOURCE_DIR}/resources/web-manifest.json"
  "${HLS_WEB_BUNDLE}")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/resources/web-manifest.json" HLS_WEB_MANIFEST)
string(JSON HLS_WEB_SHA GET "${HLS_WEB_MANIFEST}" sha256)
string(JSON HLS_WEB_RAW_SIZE GET "${HLS_WEB_MANIFEST}" uncompressedBytes)
file(SHA256 "${HLS_WEB_BUNDLE}" HLS_WEB_ACTUAL_SHA)
if(NOT HLS_WEB_ACTUAL_SHA STREQUAL HLS_WEB_SHA)
  message(FATAL_ERROR "Packed web resource checksum mismatch")
endif()
string(JSON HLS_WEB_SOURCE_COUNT LENGTH "${HLS_WEB_MANIFEST}" sources)
math(EXPR HLS_WEB_LAST "${HLS_WEB_SOURCE_COUNT}-1")
foreach(HLS_SOURCE_INDEX RANGE ${HLS_WEB_LAST})
  string(JSON HLS_SOURCE_NAME MEMBER "${HLS_WEB_MANIFEST}" sources ${HLS_SOURCE_INDEX})
  string(JSON HLS_SOURCE_SHA GET "${HLS_WEB_MANIFEST}" sources "${HLS_SOURCE_NAME}")
  file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${HLS_SOURCE_NAME}" HLS_SOURCE_ACTUAL)
  if(NOT HLS_SOURCE_ACTUAL STREQUAL HLS_SOURCE_SHA)
    message(FATAL_ERROR "Stale packed web assets: run python tools/assets/pack_web.py")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${HLS_SOURCE_NAME}")
endforeach()
file(READ "${HLS_WEB_BUNDLE}" HLS_WEB_HEX HEX)
string(REGEX REPLACE ".." "0x\\0," HLS_WEB_BYTES "${HLS_WEB_HEX}")
configure_file(cmake/templates/web_data.hpp.in generated/web_data.hpp @ONLY)

# Pre-rendered icons keep ordinary builds independent of image tooling.
set(HLS_BRAND_DIR "${CMAKE_CURRENT_SOURCE_DIR}/resources/branding")
file(READ "${HLS_BRAND_DIR}/manifest.json" HLS_BRAND_MANIFEST)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${HLS_BRAND_DIR}/manifest.json")
string(JSON HLS_BRAND_FILE_COUNT LENGTH "${HLS_BRAND_MANIFEST}" files)
math(EXPR HLS_BRAND_FILE_LAST "${HLS_BRAND_FILE_COUNT}-1")
foreach(HLS_BRAND_FILE_INDEX RANGE ${HLS_BRAND_FILE_LAST})
  string(JSON HLS_BRAND_FILE MEMBER "${HLS_BRAND_MANIFEST}" files ${HLS_BRAND_FILE_INDEX})
  string(JSON HLS_BRAND_EXPECTED GET "${HLS_BRAND_MANIFEST}" files "${HLS_BRAND_FILE}")
  file(SHA256 "${HLS_BRAND_DIR}/${HLS_BRAND_FILE}" HLS_BRAND_ACTUAL)
  if(NOT HLS_BRAND_EXPECTED STREQUAL HLS_BRAND_ACTUAL)
    message(FATAL_ERROR "Stale brand icon: run python tools/assets/make_icons.py")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${HLS_BRAND_DIR}/${HLS_BRAND_FILE}")
endforeach()
set(HLS_ICON_DECLARATIONS "")
foreach(HLS_ICON_PAIR "favicon|favicon.ico" "logo|logo.svg" "touch|apple-touch-icon.png")
  string(REPLACE "|" ";" HLS_ICON_PARTS "${HLS_ICON_PAIR}")
  list(GET HLS_ICON_PARTS 0 HLS_ICON_ID)
  list(GET HLS_ICON_PARTS 1 HLS_ICON_FILE)
  string(JSON HLS_ICON_SHA GET "${HLS_BRAND_MANIFEST}" assets "${HLS_ICON_FILE}" sha256)
  string(JSON HLS_ICON_RAW_SIZE GET "${HLS_BRAND_MANIFEST}" assets "${HLS_ICON_FILE}" bytes)
  string(JSON HLS_ICON_GZIP_SHA GET "${HLS_BRAND_MANIFEST}" assets "${HLS_ICON_FILE}" gzipSha256)
  file(SHA256 "${HLS_BRAND_DIR}/${HLS_ICON_FILE}.gz" HLS_ICON_GZIP_ACTUAL)
  if(NOT HLS_ICON_GZIP_SHA STREQUAL HLS_ICON_GZIP_ACTUAL)
    message(FATAL_ERROR "Packed brand icon checksum mismatch: ${HLS_ICON_FILE}")
  endif()
  file(READ "${HLS_BRAND_DIR}/${HLS_ICON_FILE}.gz" HLS_ICON_HEX HEX)
  string(REGEX REPLACE ".." "0x\\0," HLS_ICON_BYTES "${HLS_ICON_HEX}")
  string(APPEND HLS_ICON_DECLARATIONS "inline constexpr unsigned char icon_${HLS_ICON_ID}[] = { ${HLS_ICON_BYTES} };\ninline constexpr std::size_t icon_${HLS_ICON_ID}_raw_size = ${HLS_ICON_RAW_SIZE};\ninline constexpr char icon_${HLS_ICON_ID}_etag[] = \"W/\\\"hls-${HLS_ICON_SHA}\\\"\";\n")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${HLS_BRAND_DIR}/${HLS_ICON_FILE}.gz")
endforeach()
configure_file(cmake/templates/icon_data.hpp.in generated/icon_data.hpp @ONLY)
