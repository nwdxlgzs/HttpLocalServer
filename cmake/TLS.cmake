# Optional, offline, statically linked TLS backend. Apache-2.0 license selected.
option(HLS_ENABLE_TLS "Build optional mbedTLS HTTPS support" OFF)
if(NOT HLS_ENABLE_TLS)
  return()
endif()
set(HLS_MBEDTLS_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.deps/mbedtls-3.6.7" CACHE PATH "Pinned mbedTLS sources")
set(HLS_MBEDTLS_ARCHIVE "${CMAKE_CURRENT_SOURCE_DIR}/third_party/mbedtls-3.6.7.tar.bz2")
file(SHA256 "${HLS_MBEDTLS_ARCHIVE}" HLS_MBEDTLS_SHA)
if(NOT HLS_MBEDTLS_SHA STREQUAL "a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6")
  message(FATAL_ERROR "Pinned mbedTLS archive checksum mismatch")
endif()
if(NOT EXISTS "${HLS_MBEDTLS_ROOT}/include/mbedtls/ssl.h")
  file(ARCHIVE_EXTRACT INPUT "${HLS_MBEDTLS_ARCHIVE}" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/tls-source")
  set(HLS_MBEDTLS_ROOT "${CMAKE_CURRENT_BINARY_DIR}/tls-source/mbedtls-3.6.7" CACHE PATH "Pinned mbedTLS sources" FORCE)
endif()
set(ENABLE_PROGRAMS OFF CACHE BOOL "" FORCE)
set(ENABLE_TESTING OFF CACHE BOOL "" FORCE)
set(USE_STATIC_MBEDTLS_LIBRARY ON CACHE BOOL "" FORCE)
set(USE_SHARED_MBEDTLS_LIBRARY OFF CACHE BOOL "" FORCE)
set(MBEDTLS_FATAL_WARNINGS OFF CACHE BOOL "" FORCE)
set(MBEDTLS_USER_CONFIG_FILE "${CMAKE_CURRENT_SOURCE_DIR}/src/tls/mbedtls_user_config.h" CACHE FILEPATH "" FORCE)
set(MSVC_STATIC_RUNTIME ${HLS_STATIC_RUNTIME} CACHE BOOL "" FORCE)
add_subdirectory("${HLS_MBEDTLS_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}/mbedtls" EXCLUDE_FROM_ALL)
foreach(HLS_MBED_TARGET mbedcrypto mbedx509 mbedtls)
  target_include_directories(${HLS_MBED_TARGET} PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/src/tls")
  if(MSVC AND HLS_STATIC_RUNTIME)
    set_property(TARGET ${HLS_MBED_TARGET} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  endif()
  if(WIN32)
    target_compile_definitions(${HLS_MBED_TARGET} PRIVATE _WIN32_WINNT=0x0601 WINVER=0x0601)
  endif()
endforeach()
