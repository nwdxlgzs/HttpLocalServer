# Fixed-model inference. cpu_features.hpp automatically selects compilable kernels;
# cpu_kernels.cpp isolates optional instructions with function attributes.
include(CheckCXXCompilerFlag)
include(CheckCXXSourceCompiles)
set(HLS_MAGIKA_BUNDLE "${CMAKE_CURRENT_SOURCE_DIR}/third_party/magika/standard_v3_3.hlsm")
file(SHA256 "${HLS_MAGIKA_BUNDLE}" HLS_MAGIKA_SHA)
if(NOT HLS_MAGIKA_SHA STREQUAL "6aead17218a39a3db9f754e7a77364d7135e9ead26cdd243c64f4997e9fdd61e")
  message(FATAL_ERROR "Pinned Magika CPU bundle checksum mismatch")
endif()
file(READ "${HLS_MAGIKA_BUNDLE}" HLS_MAGIKA_HEX HEX)
string(REGEX REPLACE ".." "0x\\0," HLS_MAGIKA_BYTES "${HLS_MAGIKA_HEX}")
configure_file(cmake/templates/magika_data.cpp.in generated/magika_data.cpp @ONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${HLS_MAGIKA_BUNDLE}")
add_library(hls_inference STATIC src/magika.cpp src/cpu_dispatch.cpp src/cpu_kernels.cpp "${CMAKE_CURRENT_BINARY_DIR}/generated/magika_data.cpp")
target_include_directories(hls_inference PUBLIC src)
target_link_libraries(hls_inference PUBLIC Threads::Threads)
if(WIN32)
  target_compile_definitions(hls_inference PUBLIC _WIN32_WINNT=0x0601 WINVER=0x0601 NOMINMAX WIN32_LEAN_AND_MEAN)
endif()
if(MSVC)
  target_compile_options(hls_inference PRIVATE /W4 /utf-8 /permissive- /fp:precise)
  set_source_files_properties(src/cpu_kernels.cpp PROPERTIES COMPILE_OPTIONS /Qvec-)
  if(HLS_STATIC_RUNTIME)
    set_property(TARGET hls_inference PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  endif()
else()
  target_compile_options(hls_inference PRIVATE -Wall -Wextra -Wpedantic -ffp-contract=off)
  if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set_source_files_properties(src/cpu_kernels.cpp PROPERTIES COMPILE_OPTIONS -fno-tree-vectorize)
  else()
    set_source_files_properties(src/cpu_kernels.cpp PROPERTIES COMPILE_OPTIONS "-fno-vectorize;-fno-slp-vectorize")
  endif()
endif()
if(HLS_BUILD_TESTS)
  enable_testing()
  add_executable(hls_magika_probe tests/magika_probe.cpp)
  add_executable(hls_magika_tests tests/magika_tests.cpp)
  target_link_libraries(hls_magika_probe PRIVATE hls_inference)
  target_link_libraries(hls_magika_tests PRIVATE hls_inference)
  add_test(NAME magika COMMAND hls_magika_tests)
  if(MSVC AND HLS_STATIC_RUNTIME)
    target_compile_options(hls_magika_probe PRIVATE /utf-8)
    set_property(TARGET hls_magika_probe PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
    target_compile_options(hls_magika_tests PRIVATE /utf-8)
    set_property(TARGET hls_magika_tests PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  elseif(MINGW AND HLS_STATIC_RUNTIME OR HLS_FULL_STATIC)
    target_link_options(hls_magika_probe PRIVATE -static)
    target_link_options(hls_magika_tests PRIVATE -static)
  endif()
endif()
