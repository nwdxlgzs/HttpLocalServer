# Keep upstream definitions/includes scoped to this directory's function.
function(hls_add_wamr)
  set(WAMR_ROOT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/.deps/wasm-micro-runtime-WAMR-2.4.5")
  file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/third_party/wamr-2.4.5.tar.gz" digest)
  if(NOT digest STREQUAL "1ab09d51099f276ca4a1d6629f6b589aab2bd0caa01445e05031a4bed22c199b")
    message(FATAL_ERROR "WAMR source checksum mismatch")
  endif()
  if(NOT EXISTS "${WAMR_ROOT_DIR}/core/iwasm/include/wasm_export.h")
    file(ARCHIVE_EXTRACT INPUT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/wamr-2.4.5.tar.gz" DESTINATION "${CMAKE_CURRENT_SOURCE_DIR}/.deps")
  endif()
  if(WIN32)
    set(WAMR_BUILD_PLATFORM windows)
  elseif(APPLE)
    set(WAMR_BUILD_PLATFORM darwin)
  else()
    set(WAMR_BUILD_PLATFORM linux)
  endif()
  # Bytecode-only execution with explicit software bounds checks works on Win7,
  # musl and macOS. Raw host callbacks do not depend on native calling-convention ASM.
  set(WAMR_BUILD_INTERP 1)
  set(WAMR_BUILD_INSTRUCTION_METERING 1)
  set(WAMR_BUILD_ALLOC_WITH_USAGE 1)
  set(WAMR_BUILD_INVOKE_NATIVE_GENERAL 1)
  set(WAMR_DISABLE_HW_BOUND_CHECK 1)
  set(WAMR_DISABLE_APP_ENTRY 1)
  set(WAMR_BUILD_BULK_MEMORY 1)
  set(WAMR_BUILD_REF_TYPES 1)
  foreach(flag FAST_INTERP AOT JIT FAST_JIT LIBC_BUILTIN LIBC_WASI LIBC_UVWASI MULTI_MODULE LIB_PTHREAD LIB_WASI_THREADS THREAD_MGR SHARED_MEMORY SHARED_HEAP SIMD GC EXCE_HANDLING MEMORY64 DEBUG_INTERP)
    set(WAMR_BUILD_${flag} 0)
  endforeach()
  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" processor)
  if(processor MATCHES "^(arm64|aarch64)")
    set(WAMR_BUILD_TARGET AARCH64)
  elseif(processor MATCHES "^(arm|thumb)")
    set(WAMR_BUILD_TARGET ARM)
  elseif(processor MATCHES "riscv64")
    set(WAMR_BUILD_TARGET RISCV64)
  elseif(processor MATCHES "riscv32")
    set(WAMR_BUILD_TARGET RISCV32)
  elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(WAMR_BUILD_TARGET X86_64)
  else()
    set(WAMR_BUILD_TARGET X86_32)
  endif()
  include("${WAMR_ROOT_DIR}/build-scripts/runtime_lib.cmake")
  # Upstream metering is per interpreter entry. Replace its check in a generated
  # copy so start functions and re-entries share our hook's fuel and wall deadline.
  set(interpreter "${WAMR_ROOT_DIR}/core/iwasm/interpreter/wasm_interp_classic.c")
  file(READ "${interpreter}" source)
  string(FIND "${source}" "if (instructions_left == 0)" checkpoint)
  if(checkpoint LESS 0)
    message(FATAL_ERROR "WAMR metering adaptation no longer matches pinned source")
  endif()
  string(REPLACE "if (instructions_left == 0)" "if (hls_wamr_consume() || instructions_left == 0)" source "${source}")
  set(patched "${CMAKE_CURRENT_BINARY_DIR}/generated/wasm_interp_hls.c")
  file(WRITE "${patched}" "/* HLS embedding adaptation; upstream code follows. */\nextern int hls_wamr_consume(void);\n${source}")
  list(REMOVE_ITEM WAMR_RUNTIME_LIB_SOURCE "${interpreter}")
  list(APPEND WAMR_RUNTIME_LIB_SOURCE "${patched}")
  get_directory_property(defs COMPILE_DEFINITIONS)
  get_directory_property(includes INCLUDE_DIRECTORIES)
  if(APPLE)
    # CMAKE_SYSTEM_PROCESSOR describes the configuring host, not every slice of
    # a universal build. The C-only bridge selects its target for each slice.
    list(FILTER defs EXCLUDE REGEX "^BUILD_TARGET($|_|=)")
    set(apple_target "${CMAKE_CURRENT_BINARY_DIR}/generated/wamr_apple_target.h")
    file(WRITE "${apple_target}" "#if defined(__aarch64__) || defined(__arm64__)\n#define BUILD_TARGET_AARCH64\n#define BUILD_TARGET \"AARCH64\"\n#elif defined(__x86_64__)\n#define BUILD_TARGET_X86_64\n#else\n#error Unsupported macOS Wasm interpreter architecture\n#endif\n")
  endif()
  add_library(hls_wamr STATIC ${WAMR_RUNTIME_LIB_SOURCE})
  target_compile_definitions(hls_wamr PRIVATE ${defs})
  target_include_directories(hls_wamr SYSTEM PRIVATE ${includes})
  target_include_directories(hls_wamr SYSTEM PUBLIC "${WAMR_ROOT_DIR}/core/iwasm/include")
  # include() writes directory properties; restore them for our own C++ targets.
  set_property(DIRECTORY PROPERTY COMPILE_DEFINITIONS "${HLS_SAVED_DEFS}")
  set_property(DIRECTORY PROPERTY INCLUDE_DIRECTORIES "${HLS_SAVED_INCLUDES}")
  set_target_properties(hls_wamr PROPERTIES C_STANDARD 99)
  target_link_libraries(hls_wamr PUBLIC Threads::Threads)
  if(APPLE)
    target_compile_options(hls_wamr PRIVATE -include "${apple_target}")
  endif()
  if(WIN32)
    target_compile_definitions(hls_wamr PRIVATE _WIN32_WINNT=0x0601 WINVER=0x0601 NTDDI_VERSION=0x06010000 WIN32_LEAN_AND_MEAN NOMINMAX)
    target_link_libraries(hls_wamr PUBLIC ntdll)
  else()
    target_link_libraries(hls_wamr PUBLIC m ${CMAKE_DL_LIBS})
  endif()
  if(MSVC)
    target_compile_options(hls_wamr PRIVATE /utf-8)
    if(HLS_STATIC_RUNTIME)
      set_property(TARGET hls_wamr PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
    endif()
  endif()
endfunction()
get_directory_property(HLS_SAVED_DEFS COMPILE_DEFINITIONS)
get_directory_property(HLS_SAVED_INCLUDES INCLUDE_DIRECTORIES)
hls_add_wamr()
