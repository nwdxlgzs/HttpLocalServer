find_package(Python3 COMPONENTS Interpreter QUIET)
if(Python3_Interpreter_FOUND)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/assets/pack_previews.py" RESULT_VARIABLE HLS_PREVIEW_PACK_RESULT)
  if(NOT HLS_PREVIEW_PACK_RESULT EQUAL 0)
    message(FATAL_ERROR "Preview resource packing failed")
  endif()
endif()
set(HLS_PREVIEW_MANIFEST_PATH "${CMAKE_CURRENT_SOURCE_DIR}/resources/previews-manifest.json")
file(READ "${HLS_PREVIEW_MANIFEST_PATH}" HLS_PREVIEW_MANIFEST)
string(JSON HLS_PREVIEW_HASH GET "${HLS_PREVIEW_MANIFEST}" sha256)
string(JSON HLS_PREVIEW_TOTAL GET "${HLS_PREVIEW_MANIFEST}" packedBytes)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/resources/previews.bin" HLS_PREVIEW_ACTUAL_HASH)
if(NOT HLS_PREVIEW_HASH STREQUAL HLS_PREVIEW_ACTUAL_HASH)
  message(FATAL_ERROR "Preview resource checksum mismatch")
endif()
string(JSON HLS_PREVIEW_SOURCE_COUNT LENGTH "${HLS_PREVIEW_MANIFEST}" sources)
math(EXPR HLS_PREVIEW_SOURCE_LAST "${HLS_PREVIEW_SOURCE_COUNT}-1")
foreach(HLS_INDEX RANGE ${HLS_PREVIEW_SOURCE_LAST})
  string(JSON HLS_SOURCE MEMBER "${HLS_PREVIEW_MANIFEST}" sources ${HLS_INDEX})
  string(JSON HLS_EXPECTED GET "${HLS_PREVIEW_MANIFEST}" sources "${HLS_SOURCE}")
  file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${HLS_SOURCE}" HLS_ACTUAL)
  if(NOT HLS_EXPECTED STREQUAL HLS_ACTUAL)
    message(FATAL_ERROR "Stale preview resource: ${HLS_SOURCE}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${HLS_SOURCE}")
endforeach()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/resources/previews.bin" HLS_PREVIEW_HEX HEX)
string(LENGTH "${HLS_PREVIEW_HEX}" HLS_PREVIEW_HEX_LENGTH)
math(EXPR HLS_PREVIEW_EXPECTED_HEX "${HLS_PREVIEW_TOTAL}*2")
if(NOT HLS_PREVIEW_HEX_LENGTH EQUAL HLS_PREVIEW_EXPECTED_HEX)
  message(FATAL_ERROR "Preview binary changed or was truncated while configuring")
endif()
string(REGEX REPLACE ".." "0x\\0," HLS_PREVIEW_BYTES "${HLS_PREVIEW_HEX}")
string(JSON HLS_PREVIEW_COUNT LENGTH "${HLS_PREVIEW_MANIFEST}" assets)
math(EXPR HLS_PREVIEW_LAST "${HLS_PREVIEW_COUNT}-1")
set(HLS_PREVIEW_ROWS "")
foreach(HLS_INDEX RANGE ${HLS_PREVIEW_LAST})
  foreach(HLS_KEY path offset bytes rawBytes mime sha256)
    string(JSON HLS_P_${HLS_KEY} GET "${HLS_PREVIEW_MANIFEST}" assets ${HLS_INDEX} ${HLS_KEY})
  endforeach()
  string(APPEND HLS_PREVIEW_ROWS "{\"${HLS_P_path}\",${HLS_P_offset},${HLS_P_bytes},${HLS_P_rawBytes},\"${HLS_P_mime}\",\"${HLS_P_sha256}\"},\n")
endforeach()
configure_file(cmake/templates/preview_data.hpp.in generated/preview_data.hpp @ONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${HLS_PREVIEW_MANIFEST_PATH}" "${CMAKE_CURRENT_SOURCE_DIR}/resources/previews.bin" "${CMAKE_CURRENT_SOURCE_DIR}/tools/assets/pack_previews.py")
set_property(SOURCE src/web_assets.cpp APPEND PROPERTY OBJECT_DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/generated/preview_data.hpp")
